<Window x:Class="Carshering.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Carshering"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800" Background="#C7BBEE">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DataGrid Name ="Usersdt" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding full_name}" Width="150" />
                <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="120"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding password}" Width="100"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding roles.name}" Width="100" />
                <DataGridTextColumn Header="Заблокирован" Binding="{Binding is_loced}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3">
            <Button x:Name="btnAdd" Grid.Row="3" Margin="10" Content="добавить пользователя" Padding="2" Background="#F4A4D1" Click="btnAdd_Click"  />
            <Button x:Name="btnDel" Grid.Row="3" Margin="10" Content="удалить пользователя" Padding="2" Background="#F4A4D1" Click="btnDel_Click" />
            <Button x:Name="btnBlock_unblock" Grid.Row="3" Margin="10" Content="Заблокировать/разблокировать" Padding="2" Background="#F4A4D1" Click="btnBlock_unblock_Click"/>

        </StackPanel>
        
    </Grid>
</Window>
